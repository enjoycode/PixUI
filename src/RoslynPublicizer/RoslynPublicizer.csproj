<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
    </PropertyGroup>

    <ItemGroup>
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer..ctor" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer.ComputeChangeRecords" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer+ChangeRecord" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer._oldNodes" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer._newNodes" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.SyntaxDiffer._changes" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.PooledObjects.ArrayBuilder`1" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.PooledObjects.IPooled" />
        <Publicize Include="Microsoft.CodeAnalysis:Microsoft.CodeAnalysis.PooledObjects.PooledDisposer`1" />

        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Completion.CompletionFilterReason" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Completion.MatchResult" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Completion.PatternMatchHelper" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Structure.BlockStructureService" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Structure.BlockStructureOptions" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Structure.BlockStructure" />
        <Publicize Include="Microsoft.CodeAnalysis.Features:Microsoft.CodeAnalysis.Structure.BlockSpan" />

        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Host.IPersistentStorageConfiguration" />
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Storage.SolutionKey" />
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.PatternMatching.PatternMatch" />
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.PatternMatching.PatternMatchKind" />
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Formatting.SyntaxFormattingOptions" />
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Formatting.LineFormattingOptions" />
<!--        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Formatting.Formatter.FormatAsync(Microsoft.CodeAnalysis.Document,Microsoft.CodeAnalysis.Formatting.SyntaxFormattingOptions,System.Threading.CancellationToken)" />-->
        <Publicize Include="Microsoft.CodeAnalysis.Workspaces:Microsoft.CodeAnalysis.Formatting.Formatter.FormatAsync" />

        <Publicize Include="Microsoft.CodeAnalysis.CSharp.Workspaces:Microsoft.CodeAnalysis.CSharp.Formatting.CSharpSyntaxFormattingOptions" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="Krafs.Publicizer" Version="2.3.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
