<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <IsArm64 Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">true</IsArm64>
        <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    </PropertyGroup>
  
    <PropertyGroup Condition="'$(IsArm64)'=='true'">
        <DefineConstants>$(DefineConstants);ARM64</DefineConstants>
    </PropertyGroup>
    
    <Import Project="../PixUI.Drawing.Skia/Native/Macos.targets" />
    
    <ItemGroup>
        <ProjectReference Include="..\PixUI.CodeEditor\PixUI.CodeEditor.csproj"/>
        <ProjectReference Include="..\PixUI.Demo\PixUI.Demo.csproj"/>
        <ProjectReference Include="..\PixUI.Drawing.Skia\PixUI.Drawing.Skia.csproj" />
        <ProjectReference Include="..\PixUI.Platform.Mac\PixUI.Platform.Mac.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CodeAnalysis">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp.Features">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.CSharp.Features.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.Elfie">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.Elfie.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.Features">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.Features.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.Scripting">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.Scripting.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.Workspaces">
            <HintPath>..\..\out\Roslyn\Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
        </Reference>
    </ItemGroup>
    
    <ItemGroup>
        <None Remove="Resources\Cat.webp"/>
    </ItemGroup>

    <ItemGroup Condition="'$(IsArm64)'!='true'">
        <NativeReference Include="..\PixUI.CodeEditor.TreeSitter\libs\osx-x64\libtree-sitter.dylib">
            <Kind>Dynamic</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
        <NativeReference Include="..\PixUI.CodeEditor.TreeSitter\libs\osx-x64\libtree-sitter-csharp.dylib">
            <Kind>Dynamic</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
    </ItemGroup>

    <ItemGroup Condition="'$(IsArm64)'=='true'">
        <NativeReference Include="..\PixUI.CodeEditor.TreeSitter\libs\osx-arm64\libtree-sitter.dylib">
            <Kind>Dynamic</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
        <NativeReference Include="..\PixUI.CodeEditor.TreeSitter\libs\osx-arm64\libtree-sitter-csharp.dylib">
            <Kind>Dynamic</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
    </ItemGroup>
</Project>